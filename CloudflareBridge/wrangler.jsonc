{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "affection-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "Registry"
      },
      {
        "name": "DEVICE_HUB",
        "class_name": "DeviceHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Registry", "DeviceHub"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
