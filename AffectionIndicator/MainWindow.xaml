<Window x:Class="AffectionIndicator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:AffectionIndicator.Rendering"
        Title="Affection Indicator"
        Width="520" Height="236"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="Root_OnMouseLeftButtonDown">
        <rendering:GaugeView x:Name="Gauge" />
    </Grid>
</Window>
