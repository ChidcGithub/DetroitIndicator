<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07101C"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Affection"
            android:textColor="#F2F7FF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEAR BRIDGE"
            android:textColor="#80EEFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="11dp"
            android:text="Enter the desktop ID"
            android:textColor="#BFD2E6"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAIRING"
                android:textColor="#80EEFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Device ID"
                android:textColor="#8EA0B8"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/device_id"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_input"
                android:hint="ABCDEF1234"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="10"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:singleLine="true"
                android:textColor="#F2F7FF"
                android:textColorHint="#4D6079"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Bridge URL"
                android:textColor="#8EA0B8"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/bridge_url"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_input"
                android:hint="http://10.0.2.2:5210"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:singleLine="true"
                android:textColor="#F2F7FF"
                android:textColorHint="#4D6079"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_button_primary"
                android:minHeight="44dp"
                android:text="Save &amp; check"
                android:textAllCaps="false"
                android:textColor="#06121A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="CONTROLS"
            android:textColor="#80EEFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_inc"
                style="@style/ControlButton"
                android:text="Small +" />

            <Button
                android:id="@+id/btn_dec"
                style="@style/ControlButton"
                android:layout_marginStart="7dp"
                android:text="Small −" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_inc_big"
                style="@style/ControlButton"
                android:text="Big +" />

            <Button
                android:id="@+id/btn_dec_big"
                style="@style/ControlButton"
                android:layout_marginStart="7dp"
                android:text="Big −" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_unlock"
                style="@style/ControlButton"
                android:text="Unlock" />

            <Button
                android:id="@+id/btn_lock"
                style="@style/ControlButton"
                android:layout_marginStart="7dp"
                android:text="Lock" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_neutral"
            style="@style/ControlButton"
            android:layout_width="match_parent"
            android:layout_marginTop="7dp"
            android:layout_weight="0"
            android:text="Name only" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_show"
                style="@style/ControlButton"
                android:text="Show" />

            <Button
                android:id="@+id/btn_hide"
                style="@style/ControlButton"
                android:layout_marginStart="7dp"
                android:text="Hide" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:lineSpacingExtra="2dp"
            android:text="Start the bridge on your PC. The ID is under Settings → Bridge."
            android:textColor="#5D728C"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
